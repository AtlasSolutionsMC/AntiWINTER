    {
      "id": "kick",
      "lane": "client",
      "col": 5,
      "type": "security",
      "label": "Kick player",
      "sublabel": "Player entity scheduler"
    },
    {
      "id": "brands",
      "lane": "packets",
      "col": 1,
      "type": "messagebus",
      "label": "Read brand / channels",
      "sublabel": "minecraft:brand and minecraft:register"
    },
    {
      "id": "brand-result",
      "lane": "detection",
      "col": 2,
      "type": "security",
      "label": "Classify client signal",
      "sublabel": "OPSEC adds VL; unknown brand is review-only"
    }
  ],
  "edges": [
    {
      "id": "join-wait",
      "from": "join",
      "to": "wait",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "wait-position",
      "from": "wait",
      "to": "position",
      "variant": "default",
      "role": "main"
    },
    {
      "id": "position-probe",
      "from": "position",
      "to": "probe",
      "label": "safe spot found",
      "variant": "default",
      "role": "main"
    },
    {
      "id": "probe-client",
      "from": "probe",
      "to": "client-response",
      "label": "sign + open editor",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "client-packet",
      "from": "client-response",
      "to": "packet-match",
      "label": "UPDATE_SIGN",
      "variant": "default",
      "role": "main"
    },
    {
      "id": "packet-evaluate",
      "from": "packet-match",
      "to": "evaluate",
      "variant": "security",
      "role": "main"
    },
    {
      "id": "evaluate-score",
      "from": "evaluate",
      "to": "score",
      "label": "confirmed punitive probe",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "score-threshold",
      "from": "score",
      "to": "threshold",
      "variant": "security"
    },
    {
      "id": "threshold-kick",
      "from": "threshold",
      "to": "kick",
      "label": "yes",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "brand-check",
      "from": "brands",
      "to": "brand-result",
      "variant": "security"
    },
    {
      "id": "brand-score",
      "from": "brand-result",
      "to": "score",
      "label": "OPSEC",
      "variant": "security"
    },
    {
      "id": "brand-review",
      "from": "brand-result",
      "to": "review",
      "label": "unknown brand",
      "variant": "dashed",
      "role": "branch"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Kick rule",
      "items": [
        "Kick only when confirmed, distinct punitive signals reach VL 2.",
        "The same signal type counts once per connection; disconnect resets state."
      ]
    },
    {
      "dot": "amber",
      "title": "Review without punishment",
      "items": [
        "Unknown brands, utility probes, protected responses and timeouts alert staff only.",
        "Probe results must repeat in the confirmation pass before they add VL.",
        "A probe timeout is inconclusive and adds no VL."
      ]
    }
  ]
