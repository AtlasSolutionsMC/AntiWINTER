    {
      "id": "score",
      "lane": "detection",
      "col": 4,
      "type": "security",
      "label": "Record confirmed signal",
      "sublabel": "Unique signal adds 1 VL per connection"
    },
    {
      "id": "threshold",
      "lane": "detection",
      "col": 5,
      "type": "security",
      "label": "VL reaches 2?",
