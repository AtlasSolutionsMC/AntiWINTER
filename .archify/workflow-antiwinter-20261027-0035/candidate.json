  "nodes": [
    {
      "id": "join",
      "lane": "client",
      "col": 0,
      "type": "external",
      "label": "Player joins",
      "sublabel": "Start delayed probe"
    },
    {
      "id": "wait",
      "lane": "server",
      "col": 1,
      "type": "backend",
      "label": "Wait 60 ticks",
      "sublabel": "Run on the player scheduler"
    },
    {
      "id": "position",
      "lane": "server",
      "col": 2,
      "type": "security",
      "label": "Find safe probe spot",
      "sublabel": "Skip if no suitable space"
    },
    {
      "id": "probe",
      "lane": "server",
      "col": 3,
      "type": "messagebus",
      "label": "Send fake sign probe",
      "sublabel": "Remove server block after 1 tick"
    },
    {
      "id": "client-response",
      "lane": "client",
      "col": 3,
      "type": "external",
      "label": "Client resolves keys",
      "sublabel": "Translation / keybind response"
    },
    {
      "id": "packet-match",
      "lane": "packets",
      "col": 4,
      "type": "security",
      "label": "Match active UPDATE_SIGN",
      "sublabel": "Cancel matched packet"
    },
    {
      "id": "evaluate",
      "lane": "packets",
      "col": 5,
      "type": "backend",
      "label": "Evaluate probe response",
      "sublabel": "Require matching confirmation pass"
    },
    {
      "id": "review",
      "lane": "staff",
      "col": 2,
      "type": "external",
      "label": "Alert staff",
      "sublabel": "Unknown brand or review-only signal"
